[Unit]
Description=agyx-next loop supervisor (pi + NVIDIA NIM)
Wants=network-online.target
After=network-online.target

[Service]
User=agent
Group=agent
Environment=TZ=America/Bahia
Environment=AGYX_CONTAINER=1
EnvironmentFile=-/etc/agyx-loop.env
WorkingDirectory=/home/sh-lucas/Github/rox-projects/agyx/agyx-next/loop
ExecStart=/usr/bin/python3 -I supervisor.py run
Restart=on-failure
RestartSec=60
KillSignal=SIGTERM
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
