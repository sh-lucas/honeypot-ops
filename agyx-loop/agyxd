#!/usr/bin/env bash
# Controle do loop do agyx-next em container (Podman + systemd dentro do container + unidade systemd do usuário no host).
#
#   ./agyxd build            constrói a imagem (podman build)
#   ./agyxd up               sobe o container (podman run; systemd vira PID 1)
#   ./agyxd install-service  gera e habilita a unidade systemd do usuário que mantém o container vivo
#   ./agyxd uninstall-service
#   ./agyxd down             para container e unidade
#   ./agyxd restart          reinicia o container
#   ./agyxd status           container + serviço de dentro + fila do loop
#   ./agyxd logs             console do systemd no container (podman logs -f)
#   ./agyxd journal          journalctl -u agyx-loop dentro do container
#   ./agyxd tail             supervisor.log do loop (arquivo no host, via mount)
#   ./agyxd once             roda UMA tarefa no container (teste; o lock impede duplicar)
#   ./agyxd shell            bash como usuário agent dentro do container
#   ./agyxd service          systemctl do serviço dentro do container (ex.: ./agyxd service restart)
set -euo pipefail
cd "$(dirname "$0")"

NAME=agyx-loop
IMAGE=localhost/agyx-loop:latest
UNIT=agyx-loop-container.service
REPO="${AGYX_REPO:-/home/sh-lucas/Github/rox-projects/agyx/agyx-next}"
ENV_FILE="${AGYX_ENV:-$HOME/.config/agyx-loop.env}"

common_mounts=(
  -v "$REPO:$REPO:rw"
  -v "$ENV_FILE:/etc/agyx-loop.env:ro"
  -v "$PWD/pi-models.json:/home/agent/.pi/agent/models.json:ro"
  -v "$HOME/go:/home/agent/go:rw"
  -v "$HOME/.cache/go-build:/home/agent/.cache/go-build:rw"
  -e TZ=America/Bahia
)

ensure_image() {
  podman image exists "$IMAGE" 2>/dev/null && return 0
  docker image inspect agyx-loop:latest >/dev/null 2>&1 || { echo "imagem não encontrada; rode ./agyxd build" >&2; exit 1; }
  docker save agyx-loop:latest | podman load
  podman tag docker.io/library/agyx-loop:latest "$IMAGE"
}

case "${1:-}" in
  build)
    podman build -t "$IMAGE" .
    ;;
  up)
    ensure_image
    [[ -f "$ENV_FILE" ]] || { echo "faltando $ENV_FILE (NVIDIA_API_KEY=...)" >&2; exit 1; }
    podman rm -f "$NAME" >/dev/null 2>&1 || true
    podman run -d --name "$NAME" \
      --hostname "$NAME" \
      --systemd=always \
      --stop-timeout=120 \
      --userns=keep-id:uid=1000,gid=1000 \
      "${common_mounts[@]}" \
      "$IMAGE"
    sleep 4
    podman exec "$NAME" systemctl is-system-running || true
    podman exec "$NAME" systemctl --no-pager status agyx-loop.service 2>&1 | head -6 || true
    ;;
  install-service)
    podman container exists "$NAME" || { echo "container $NAME não existe; rode ./agyxd up primeiro" >&2; exit 1; }
    mkdir -p ~/.config/systemd/user
    podman generate systemd --new --name "$NAME" > ~/.config/systemd/user/"$UNIT"
    sed -i 's/^Restart=on-failure/Restart=always/' ~/.config/systemd/user/"$UNIT"
    systemctl --user daemon-reload
    loginctl show-user "$USER" -p Linger | grep -q yes || loginctl enable-linger "$USER"
    systemctl --user enable --now "$UNIT"
    systemctl --user status "$UNIT" --no-pager | head -8
    ;;
  uninstall-service)
    systemctl --user disable --now "$UNIT" || true
    rm -f ~/.config/systemd/user/"$UNIT"
    systemctl --user daemon-reload
    ;;
  down)
    systemctl --user stop "$UNIT" 2>/dev/null || podman stop -t 120 "$NAME" || true
    ;;
  restart)
    systemctl --user restart "$UNIT" 2>/dev/null || podman restart "$NAME"
    ;;
  status)
    podman ps -a --filter "name=$NAME" --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
    podman exec "$NAME" systemctl is-active agyx-loop.service 2>/dev/null || true
    tail -12 "$REPO/loop/state/STATUS.md" 2>/dev/null || true
    ;;
  logs)
    podman logs -f "$NAME"
    ;;
  journal)
    podman exec -it "$NAME" journalctl -u agyx-loop -n 100 -f
    ;;
  tail)
    exec tail -n 100 -f "$REPO/loop/var/supervisor.log"
    ;;
  once)
    podman exec -it -u agent -w "$REPO/loop" "$NAME" python3 -I supervisor.py run --once
    ;;
  shell)
    podman exec -it -u agent -w "$REPO" "$NAME" bash
    ;;
  service)
    shift
    podman exec -it "$NAME" systemctl "$@" agyx-loop.service
    ;;
  *)
    grep '^#   ' "$0" | sed 's/^#   //'
    exit 1
    ;;
esac
